# 이 파일을 복사해서 .env 파일을 만들고, 실제 값을 채워 넣으세요.
# .env는 .gitignore에 들어 있어서 GitHub에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 키를 적지 마세요.
GEMINI_API_KEY=
# 주변 시설(AI 예시)용 Gemini 키. 설명용 키와 사용량을 나누려고 따로 둔다. 비어 있으면 주변 시설 API만 503
GEMINI_FACILITY_API_KEY=
# Gemini 모델 이름. 비워 두면 gemini-3.5-flash-lite
GEMINI_MODEL=
DATABASE_URL=postgresql://localhost:5432/subfit
# 챗봇 나노 모델 실행기를 직접 빌드해서 쓸 때만 그 파일의 경로. 비워 두면 backend/app/chat/nano/bin/의 실행기를 쓴다
SUBFIT_NANO_BIN=
